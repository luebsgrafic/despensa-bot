# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name (default: gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash-lite

# Neon DB connection string (PostgreSQL serverless)
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/despensa?sslmode=require

# Neon DB connection string for tests (optional, separate branch recommended)
# DATABASE_URL_TEST=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Webhook URL (for VPS deployment with nginx)
WEBHOOK_URL=https://luebsgrafic.duckdns.org/api/webhook

# Port for the webhook server (default 3000)
PORT=3000

# Comma-separated list of allowed Telegram user IDs (leave empty to allow all)
TELEGRAM_ALLOWED_USERS=

# Timezone for cron jobs (e.g. Europe/Madrid)
TIMEZONE=Europe/Madrid

# Mem0 API key for persistent memory layer (optional)
MEM0_API_KEY=your_mem0_api_key_here
