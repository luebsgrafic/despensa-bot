# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Allowed Telegram user IDs, comma-separated. Leave empty to allow all.
TELEGRAM_ALLOWED_USERS=

# Neon DB connection string
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Neon DB connection string for tests, optional
# DATABASE_URL_TEST=postgresql://user:password@host/testdb?sslmode=require

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# mem0 semantic memory, optional
MEM0_API_KEY=your_mem0_api_key_here

# Webhook URL for VPS deployment
WEBHOOK_URL=https://your-domain.com/api/webhook

# Port for webhook server
PORT=3000

# Timezone for cron jobs
TIMEZONE=Europe/Madrid
