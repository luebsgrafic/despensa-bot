# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# DeepSeek API key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Comma-separated list of numeric Telegram user IDs allowed to use the bot
TELEGRAM_ALLOWED_USERS=123456789,987654321,111222333,444555666

# Neon DB connection string (PostgreSQL serverless)
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/despensa?sslmode=require
