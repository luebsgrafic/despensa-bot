{
  "name": "despensa-bot",
  "version": "1.0.0",
  "description": "Telegram bot for household inventory management",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "set-webhook": "tsx src/scripts/set-webhook.ts"
  },
  "keywords": [
    "telegram",
    "bot",
    "inventory",
    "despensa"
  ],
  "license": "MIT",
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^17.4.2",
    "node-cron": "^4.2.1",
    "openai": "^6.35.0",
    "telegraf": "^4.16.3"
  },
  "overrides": {
    "uuid": "^11.1.0",
    "node-domexception": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "@vercel/node": "^5.7.15",
    "eslint": "^10.3.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
